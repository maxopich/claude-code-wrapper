# Default workspace root used when nothing is set in the UI. The browser-side
# Settings panel writes to ~/.cebab/cebab.sqlite which always wins. This is
# only the fallback for fresh installs and scripted launches.
WORKSPACE_ROOT=~/agents

# Set to 1 to replay fixtures/*.jsonl instead of spawning real `claude`.
MOCK=0

# Bus replay scenario directory under fixtures/bus/. Unset -> each router uses
# its own built-in default (`chain` / `orchestrator`), which is what plain
# MOCK=1 wants. Ignored outside mock mode.
# MOCK_SCENARIO=chain

# Delay in ms between replayed fixture events. The 50 ms default paces a
# single-agent replay so the UI streams visibly; a bus session multiplies it by
# every hop, so lower it when replaying long sessions.
# MOCK_INTERVAL_MS=50

# WebSocket server port. The web client connects to this port, and so does
# vite's dev-mode proxy (see web/vite.config.ts).
PORT=4319

# Hard cap on agent turns per user message. Prevents runaway loops.
# MAX_TURNS=50

# Hard cap on hops in a multi-agent session — the bus counterpart to MAX_TURNS.
# Per-launch override only: the Settings modal's `hop_budget` wins over this,
# and this wins over the built-in default of 30. Raise it for large rosters (a
# 5-worker capability handshake spends ~10 hops before any work starts).
# CEBAB_HOP_BUDGET=30

# Comma-separated extra Origins permitted to open the WS and fetch the auth
# token. Cebab trusts only the port it BINDS (PORT above); everything else has
# to be declared here. Needed when you serve the built bundle from another
# port — and when you run the two halves in separate terminals, because only
# `npm run dev` declares the Vite origin (it is the thing that starts Vite).
#
#   npm run dev                    -> nothing to set, the launcher declares it
#   npm run dev:server + dev:web   -> uncomment the line below
#
# CEBAB_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Optional: override the port the browser dials. Defaults to PORT above.
# Useful if you front the server with a reverse proxy on a different port.
# VITE_SERVER_PORT=4319

# Where Cebab keeps its database, logs and auth token. Defaults to ~/.cebab.
# Read once at startup. Point it elsewhere to run against a scratch data dir
# without disturbing your real one — the test suite sets this per worker for
# exactly that reason, and `getDb()` refuses to open the real directory from
# a test.
# CEBAB_DATA_DIR=~/.cebab

# THE ONLY SETTING HERE THAT DESTROYS DATA. Idle-session auto-reclamation:
# when set to a positive integer, the purge cron soft-deletes every session
# idle longer than that many days. OFF by default — unset, blank, non-numeric
# or <= 0 all mean off, and it stays off unless you deliberately set a number.
# Reclaimed sessions stay recoverable for 7 days through the existing undo
# window, and every reclamation writes a safety_audit row.
# CEBAB_AUTO_RECLAIM_DAYS=30
